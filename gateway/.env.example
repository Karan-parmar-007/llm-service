# Copy to .env next to app.py on a PC (run.sh / run.ps1). The LLM VPS runs the Docker
# image instead; its .env is new_deployment/studio-gateway/.env.example.

# Which halves this machine serves.
#   LLM VPS: LLM_ENABLED=1, SPEECH_ENABLED=0
#   PC:      LLM_ENABLED=1, SPEECH_ENABLED=1
LLM_ENABLED=1
SPEECH_ENABLED=0

# Shared secret. Must equal FLOW_TOKEN in studio-backend. Empty = no auth (dev only).
FLOW_TOKEN=

# Where gunicorn listens.
#   LLM VPS: 0.0.0.0:8011 (firewall the port so only the web VPS can reach it)
#   PC:      0.0.0.0:8003
BIND=0.0.0.0:8011

# LLM half: Ollama on this machine
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q5_K_M
OLLAMA_TIMEOUT_SECONDS=180

# Speech half: CTranslate2 folder of the Tara (faster-whisper) model
TARA_DIR=~/models/tara-ct2
# Load and warm the model at start (1) or on the first request (0)
TARA_EAGER=1

# Keep-alive (LLM VPS only): keeps the CPU busy while nobody uses the LLM so Oracle
# doesn't reclaim the instance as idle, and cancels its own generation the moment a
# user request arrives. Runs BUSY seconds, rests IDLE seconds, and only starts after
# QUIET seconds with no user traffic. 20/40 keeps roughly a third of each minute busy.
KEEPALIVE_ENABLED=0   # set 1 on the LLM VPS only
KEEPALIVE_BUSY_SECONDS=20
KEEPALIVE_IDLE_SECONDS=40
KEEPALIVE_QUIET_SECONDS=30
